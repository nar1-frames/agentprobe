# NEVER commit these to GitHub
.env
*.env

# Python cache files
__pycache__/
*.pyc
*.pyo

# Reports contain scan results — keep local only
reports/
*.checkpoint.json
*.checkpoint.jsonl
# Replay recordings hold raw prompts and model output.
*.replay.json
# The sanitized offline demo recording is the one public exception.
!agentprobe/demo/scan.replay.json
.DS_Store

# Disclosure workflow (v1.2) — real engagements + unpatched vulns stay local.
# The template under disclosure/templates/ IS committed; everything below is not.
disclosure/authorizations/*.yaml
disclosure/authorizations/*.yml
disclosure/data/
!disclosure/authorizations/.gitkeep

# local virtualenv
.venv/
*.egg-info/
build/
wheelhouse/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Desktop/consolidation duplicate artifacts; keep them out of the public tree.
**/* 2.py
**/* 2.md
**/* 2.yaml
**/* 2.json
**/* 2.jsonl
**/* 2.csv
**/* 2.docx
**/* 2.html
**/* 2.png
**/* 2.txt
**/* 2.b
**/* 2.ini
**/* 2.tgz

# Local agent instructions are workspace metadata, not project artifacts.
**/AGENTS.md

# Historical/consolidation copies kept locally for recovery, never public.
_variants_from_B/
agentprobe-backup-preconsolidation/
dist/
mysession.txt
report_html.py
data/judgements_clean.jsonl
data/judgements_errors_pilot.jsonl
data/results_pilot.json
data/*.errors.jsonl

# Empirical-study artifacts contain raw model outputs and human labels. Keep
# the working copies local until the protocol is complete and disclosure is
# explicitly reviewed; publish a sanitized release separately if appropriate.
data/corpus.jsonl
data/judgements.jsonl
data/labels.csv
data/results.json

# Blinded human-label packets contain raw model responses; keep them local.
*.label-packet.csv
*.label-packet.csv.key.json

# Local archive of retired scripts and notes.
_archive/

# Prompt God work orders, reports, and plans are workspace metadata.
.promptgod/
